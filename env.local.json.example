{
  "_comment": "Copy this file to env.local.json and fill in real values. env.local.json is gitignored.",

  "BedrockOrchestratorFunction": {
    "BEDROCK_MODEL_ID": "anthropic.claude-sonnet-5-5",
    "BEDROCK_REGION": "eu-west-1",
    "DOCUMENT_BUCKET": "your-real-s3-bucket-name",
    "MAX_TOKENS": "1024",
    "LOG_LEVEL": "INFO"
  },
  "RagIngestionFunction": {
    "DOCUMENT_BUCKET": "your-real-s3-bucket-name",
    "EMBEDDING_LAMBDA_ARN": "arn:aws:lambda:eu-west-1:123456789012:function:your-prefix-rag-embedding",
    "CHUNK_SIZE": "1000",
    "CHUNK_OVERLAP": "200",
    "LOG_LEVEL": "INFO"
  },
  "RagEmbeddingFunction": {
    "BEDROCK_EMBEDDING_MODEL_ID": "amazon.titan-embed-text-v2:0",
    "BEDROCK_REGION": "eu-west-1",
    "OPENSEARCH_ENDPOINT": "https://your-opensearch-collection-id.eu-west-1.aoss.amazonaws.com",
    "OPENSEARCH_INDEX": "rag-documents",
    "LOG_LEVEL": "INFO"
  },
  "RagRetrievalFunction": {
    "BEDROCK_EMBEDDING_MODEL_ID": "amazon.titan-embed-text-v2:0",
    "BEDROCK_REGION": "eu-west-1",
    "OPENSEARCH_ENDPOINT": "https://your-opensearch-collection-id.eu-west-1.aoss.amazonaws.com",
    "OPENSEARCH_INDEX": "rag-documents",
    "TOP_K": "5",
    "LOG_LEVEL": "INFO"
  },
  "RagOrchestratorFunction": {
    "BEDROCK_MODEL_ID": "anthropic.claude-sonnet-5-5",
    "BEDROCK_REGION": "eu-west-1",
    "RETRIEVAL_LAMBDA_ARN": "arn:aws:lambda:eu-west-1:123456789012:function:your-prefix-rag-retrieval",
    "MAX_TOKENS": "2048",
    "TOP_K": "5",
    "PROMPT_MODE": "rag",
    "LOG_LEVEL": "INFO"
  }
}
